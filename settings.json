{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "disableClaudeAiConnectors": true,
  "disableSkillShellExecution": true,
  "enableArtifact": false,
  "env": {
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1"
  },
  "permissions": {
    "allow": [
      "Edit(./.sandbox/**)",

      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:developer.mozilla.org)"
    ],
    "ask": [
      "Bash(find *-delete*)",

      "Bash(rm *)",
      "Bash(rsync *--delete*)",
      "Bash(shred *)",
      "Bash(truncate *)",

      "Edit(./.claude/**)",
      "Edit(./.gitignore)",
      "Edit(./.mcp.json)",
      "Edit(~/.claude.json)",
      "Edit(~/.claude/**)"
    ],
    "deny": [
      "Bash(env)",

      "Bash(gh auth status *--show-token*)",
      "Bash(gh auth status *-t*)",
      "Bash(gh auth token*)",

      "Bash(git -C * clean*)",
      "Bash(git -C * push*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git clean*)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",

      "Bash(printenv*)",

      "Bash(rm --recursive*)",
      "Bash(rm -R*)",
      "Bash(rm -fR*)",
      "Bash(rm -fr*)",
      "Bash(rm -r*)",

      "Bash(sudo *)",

      "Edit(**/*.crt)",
      "Read(**/*.crt)",

      "Edit(**/*.env)",
      "Read(**/*.env)",

      "Edit(**/*.key)",
      "Read(**/*.key)",

      "Edit(**/*.p12)",
      "Read(**/*.p12)",

      "Edit(**/*.pem)",
      "Read(**/*.pem)",

      "Edit(**/*.pfx)",
      "Read(**/*.pfx)",

      "Edit(**/.env)",
      "Read(**/.env)",

      "Edit(**/.env.*)",
      "Read(**/.env.*)",

      "Edit(**/.envrc)",
      "Read(**/.envrc)",

      "Edit(**/.git-credentials)",
      "Read(**/.git-credentials)",

      "Edit(**/.netrc)",
      "Read(**/.netrc)",

      "Edit(**/.ssh/**)",
      "Read(**/.ssh/**)",

      "Edit(**/id_ecdsa*)",
      "Read(**/id_ecdsa*)",

      "Edit(**/id_ed25519*)",
      "Read(**/id_ed25519*)",

      "Edit(**/id_rsa*)",
      "Read(**/id_rsa*)",

      "Edit(~/**/.git/config)",
      "Edit(~/**/.git/hooks/**)",

      "Edit(~/.bash_history)",
      "Read(~/.bash_history)",

      "Edit(~/.git-credentials)",
      "Read(~/.git-credentials)",

      "Edit(~/.gnupg/**)",
      "Read(~/.gnupg/**)",

      "Edit(~/.netrc)",
      "Read(~/.netrc)",

      "Edit(~/.ssh/**)",
      "Read(~/.ssh/**)",

      "Edit(~/.zsh_history)",
      "Read(~/.zsh_history)",

      "Edit(~/.zsh_sessions/**)",
      "Read(~/.zsh_sessions/**)"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "blockWritesOutsideWorkingDirectories": true,
    "disableBypassPermissionsMode": "disable"
  },
  "remoteControlAtStartup": false,
  "respectGitignore": true,
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "credentials": {
      "files": [
        { "mode": "deny", "path": "~/.bash_history" },
        { "mode": "deny", "path": "~/.git-credentials" },
        { "mode": "deny", "path": "~/.gnupg" },
        { "mode": "deny", "path": "~/.netrc" },
        { "mode": "deny", "path": "~/.ssh" },
        { "mode": "deny", "path": "~/.zsh_history" },
        { "mode": "deny", "path": "~/.zsh_sessions" }
      ]
    },
    "enabled": true,
    "excludedCommands": [],
    "failIfUnavailable": true,
    "filesystem": {
      "allowRead": ["~/.claude/settings.json"],
      "denyWrite": ["~/**/.git/config", "~/**/.git/hooks"]
    },
    "network": {
      "allowedDomains": []
    }
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/hooks/statusline.sh"
  }
}
