{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoContinueAtUsageLimit": false,
  "cleanupPeriodDays": 14,
  "disableClaudeAiConnectors": true,
  "disableSkillShellExecution": true,
  "enableArtifact": false,
  "env": {
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "~/.claude/hooks/git.sh",
            "onFailure": "block",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "~/.claude/hooks/read.sh",
            "onFailure": "block",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  },
  "minimumVersion": "2.1.330",
  "permissions": {
    "additionalDirectories": ["~/.claude/rules/local"],
    "allow": [
      "Edit(./.sandbox/**)",

      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:developer.mozilla.org)"
    ],
    "ask": [
      "Bash(find *-delete*)",
      "Bash(rm *)",
      "Bash(rsync *--delete*)",

      "Bash(shred *)",
      "Bash(truncate *)",

      "Edit(**/.gitignore)",
      "Edit(**/.mcp.json)"
    ],
    "deny": [
      "Bash(env)",

      "Bash(git -C * checkout *-- *)",
      "Bash(git -C * clean*)",
      "Bash(git -C * filter-repo*)",
      "Bash(git -C * gc --prune*)",
      "Bash(git -C * push*)",
      "Bash(git -C * reflog expire*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git -C * restore*)",
      "Bash(git -C * stash clear*)",
      "Bash(git -C * switch *--discard-changes*)",
      "Bash(git -C * switch *--force*)",
      "Bash(git -C * switch -f*)",
      "Bash(git -C * worktree remove *--force*)",
      "Bash(git -C * worktree remove -f*)",
      "Bash(git checkout *-- *)",
      "Bash(git clean*)",
      "Bash(git filter-repo*)",
      "Bash(git gc --prune*)",
      "Bash(git push*)",
      "Bash(git reflog expire*)",
      "Bash(git reset --hard*)",
      "Bash(git restore*)",
      "Bash(git stash clear*)",
      "Bash(git switch *--discard-changes*)",
      "Bash(git switch *--force*)",
      "Bash(git switch -f*)",
      "Bash(git worktree remove *--force*)",
      "Bash(git worktree remove -f*)",

      "Bash(printenv*)",

      "Bash(sudo *)",

      "Edit(**/*.env)",
      "Read(**/*.env)",

      "Edit(**/*.kdbx)",
      "Read(**/*.kdbx)",

      "Edit(**/*.key)",
      "Read(**/*.key)",

      "Edit(**/*.keystore)",
      "Read(**/*.keystore)",

      "Edit(**/*.p12)",
      "Read(**/*.p12)",

      "Edit(**/*.pem)",
      "Read(**/*.pem)",

      "Edit(**/*.pfx)",
      "Read(**/*.pfx)",

      "Edit(**/*.ppk)",
      "Read(**/*.ppk)",

      "Edit(**/.env)",
      "Read(**/.env)",

      "Edit(**/.env.*)",
      "Read(**/.env.*)",

      "Edit(**/.envrc)",
      "Read(**/.envrc)",

      "Edit(**/.git-credentials)",
      "Read(**/.git-credentials)",

      "Edit(**/.netrc)",
      "Read(**/.netrc)",

      "Edit(**/.ssh/**)",
      "Read(**/.ssh/**)",

      "Edit(**/id_ecdsa*)",
      "Read(**/id_ecdsa*)",

      "Edit(**/id_ed25519*)",
      "Read(**/id_ed25519*)",

      "Edit(**/id_rsa*)",
      "Read(**/id_rsa*)",

      "Edit(~/**/.git/config)",
      "Edit(~/**/.git/hooks/**)",

      "Edit(~/.bash_history)",
      "Read(~/.bash_history)",

      "Edit(~/.git-credentials)",
      "Read(~/.git-credentials)",

      "Edit(~/.gnupg/**)",
      "Read(~/.gnupg/**)",

      "Edit(~/.netrc)",
      "Read(~/.netrc)",

      "Edit(~/.ssh/**)",
      "Read(~/.ssh/**)",

      "Edit(~/.zsh_history)",
      "Read(~/.zsh_history)",

      "Edit(~/.zsh_sessions/**)",
      "Read(~/.zsh_sessions/**)"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "blockWritesOutsideWorkingDirectories": true,
    "disableBypassPermissionsMode": "disable"
  },
  "remoteControlAtStartup": false,
  "respectGitignore": true,
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "credentials": {
      "files": [
        { "mode": "deny", "path": "~/.bash_history" },
        { "mode": "deny", "path": "~/.git-credentials" },
        { "mode": "deny", "path": "~/.gnupg" },
        { "mode": "deny", "path": "~/.netrc" },
        { "mode": "deny", "path": "~/.ssh" },
        { "mode": "deny", "path": "~/.zsh_history" },
        { "mode": "deny", "path": "~/.zsh_sessions" }
      ]
    },
    "enabled": true,
    "excludedCommands": [],
    "failIfUnavailable": true,
    "filesystem": {
      "allowRead": ["~/.config/git/allowed_signers"],
      "denyWrite": ["~/**/.git/config", "~/**/.git/hooks"]
    },
    "network": {
      "allowedDomains": []
    }
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/hooks/statusline.sh"
  },
  "syncClaudeAiSkills": false
}
