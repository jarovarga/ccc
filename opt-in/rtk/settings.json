{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "command": "rtk hook claude",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "filesystem": {
      "allowRead": ["~/.claude/settings.json"]
    }
  }
}
